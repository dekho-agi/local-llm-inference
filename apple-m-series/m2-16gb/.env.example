# MacBook Air M2 — 16 GB unified memory
# Stay at or below ~8B @ 4-bit. Copy to .env and uncomment to override.

# MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit        # ~1.8 GB
# MODEL=mlx-community/Qwen3.5-4B-MLX-4bit             # ~2.6 GB
# MODEL=mlx-community/Qwen2.5-Coder-7B-Instruct-4bit  # ~4.3 GB

# PORT=8000
# MAX_TOKENS=8192
# PROMPT_CACHE_BYTES=2G
