# MacBook Pro M5 Max — 128 GB unified memory
# Copy to .env and uncomment to override. Sizes are on-disk download size.
#
# MODEL only sets which model is preloaded at boot. mlx_lm.server loads
# whatever repo id the request asks for, so every model in models.txt is
# reachable from opencode's /models picker against this one server.

# --- fast / on battery (default: small, so ./serve.sh is ready in seconds) ---
# MODEL=mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit          # 17.2 GB
# --- daily driver (pick it in opencode; the server loads it on demand) ---
# MODEL=mlx-community/Qwen3-Coder-Next-4bit                      # 44.9 GB
# MODEL=mlx-community/GLM-4.7-Flash-4bit                         # 16.9 GB
# MODEL=mlx-community/Devstral-Small-2-24B-Instruct-2512-4bit     # 15.1 GB
# --- heavy ---
# MODEL=mlx-community/gpt-oss-120b-MXFP4-Q8                       # 63.4 GB
# MODEL=mlx-community/GLM-4.5-Air-4bit                            # 60.2 GB

# PORT=8000

# Generation ceiling per request (mlx_lm.server's own default is only 512).
# MAX_TOKENS=32768

# Cap on the reusable prompt-cache pool. Accepts 24G / 24GB / raw bytes.
# PROMPT_CACHE_BYTES=24G
# PROMPT_CACHE_SIZE=10

# KV cache quantization (4 or 8). Saves memory on very long contexts but
# DISABLES batching — requests are then served one at a time. Off by default.
# KV_BITS=8

# Extra flags passed straight to mlx_lm.server
# EXTRA_ARGS=--log-level DEBUG
