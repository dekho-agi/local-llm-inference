# Fraction of GPU VRAM to reserve for vLLM (weights + KV cache).
GPU_MEMORY_UTILIZATION=0.90

# Max context length in tokens.
# AWQ weights ~4.3 GB leave ~10 GB for KV cache — 16 K is comfortable.
# Lower to 8192 if you see OOM with multiple concurrent image requests.
MAX_MODEL_LEN=16384

# Host port for the vLLM API.
# OpenAI-compatible endpoint: http://localhost:${PORT}/v1/chat/completions
PORT=8000
