# Required: HuggingFace token with read access.
# Request model access at: https://huggingface.co/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-FP8
HF_TOKEN=hf_...

# Number of GPUs for tensor parallelism.
# FP8 weights ~120 GB -> requires TENSOR_PARALLEL_SIZE=2 on 2x RTX Pro 6000 (96 GB each).
# On a single H100 (80 GB) with the NVFP4 variant, set to 1.
TENSOR_PARALLEL_SIZE=2

# Fraction of each GPU's VRAM to use.
GPU_MEMORY_UTILIZATION=0.90

# Max context length in tokens.
MAX_MODEL_LEN=32768

# Host port for the vLLM API.
# OpenAI-compatible endpoint: http://localhost:${PORT}/v1/chat/completions
PORT=8000
