# Optional: HuggingFace token (model is public, only needed for rate-limit relief).
HF_TOKEN=

# Fraction of GPU VRAM to reserve for vLLM (weights + KV cache).
GPU_MEMORY_UTILIZATION=0.90

# Max context length in tokens.
# AWQ weights ~8 GB leave ~8 GB for KV cache — 32K is comfortable.
MAX_MODEL_LEN=32768

# Host port for the vLLM API.
# OpenAI-compatible endpoint: http://localhost:${PORT}/v1/chat/completions
PORT=8000
